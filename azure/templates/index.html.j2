<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>{{ site_title }}</title>
  <style>
    body { font-family: sans-serif; max-width: 48rem; margin: 2rem auto; padding: 0 1rem; }
    td, th { padding: .25rem .75rem; text-align: left; }
  </style>
</head>
<body>
  <h1>{{ site_title }}</h1>
  <p>Region: {{ discovered.location }}. Built by Ansible, revision {{ revision }}.</p>

  <h2>Networks</h2>
  {% for vnet in discovered.vnets %}
  <h3>{{ vnet.name }} ({{ vnet.address_prefixes | join(', ') }})</h3>
  <table>
    <tr><th>Subnet</th><th>Range</th></tr>
    {% for subnet in vnet.subnets | default([]) | sort(attribute='address_prefix') %}
    <tr><td>{{ subnet.name }}</td><td>{{ subnet.address_prefix }}</td></tr>
    {% endfor %}
  </table>
  {% else %}
  <p>No networks yet.</p>
  {% endfor %}

  <h2>Firewall rules</h2>
  {% for nsg in discovered.nsgs %}
  <h3>{{ nsg.name }}</h3>
  <table>
    <tr><th>Priority</th><th>Rule</th><th>Access</th><th>Port</th></tr>
    {% for rule in nsg.rules | default([]) | sort(attribute='priority') %}
    <tr><td>{{ rule.priority }}</td><td>{{ rule.name }}</td><td>{{ rule.access }}</td><td>{{ rule.protocol }}/{{ rule.destination_port_range }}</td></tr>
    {% endfor %}
  </table>
  {% else %}
  <p>No firewall rules yet.</p>
  {% endfor %}
</body>
</html>
